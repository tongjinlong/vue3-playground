{
  "name": "vue3-playground",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "vue-tsc -b",
    "check": "pnpm typecheck",
    "build": "pnpm typecheck && vite build",
    "preview": "vite preview",
    "lint": "pnpm lint:code && pnpm lint:style",
    "lint:code": "eslint . --max-warnings=0",
    "lint:code:fix": "eslint . --fix",
    "lint:style": "stylelint \"src/**/*.{css,scss,vue}\" --max-warnings=0",
    "lint:style:fix": "stylelint \"src/**/*.{css,scss,vue}\" --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "pnpm build && playwright test",
    "test:e2e:run": "playwright test",
    "test:e2e:report": "playwright show-report",
    "check:bundle": "node scripts/check-bundle.mjs",
    "audit:deps": "pnpm audit --audit-level high",
    "verify": "pnpm format:check && pnpm lint && pnpm test:coverage && pnpm build && pnpm check:bundle && pnpm test:e2e:run",
    "prepare": "simple-git-hooks"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "@shikijs/monaco": "^4.4.3",
    "@volar/jsdelivr": "2.4.28",
    "@volar/language-service": "2.4.28",
    "@volar/monaco": "2.4.28",
    "@vue/language-core": "^3.3.11",
    "@vue/language-service": "^3.3.11",
    "@webcontainer/api": "^1.6.4",
    "element-plus": "^2.14.5",
    "monaco-editor-core": "^0.52.2",
    "pinia": "^4.0.3",
    "shiki": "^4.4.3",
    "volar-service-typescript": "^0.0.71",
    "vscode-uri": "^3.2.0",
    "vue": "^3.5.42",
    "vue-router": "^5.3.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.13.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/coverage-v8": "^5.0.0",
    "@vue/test-utils": "^2.5.0",
    "@vue/tsconfig": "^0.9.1",
    "autoprefixer": "^10.6.0",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.11.0",
    "globals": "^17.12.0",
    "jiti": "^2.7.0",
    "jsdom": "^30.0.1",
    "lint-staged": "^17.5.1",
    "postcss": "^8.5.28",
    "postcss-html": "^2.0.0",
    "postcss-scss": "^4.0.9",
    "prettier": "^3.9.6",
    "sass-embedded": "^1.104.1",
    "simple-git-hooks": "^2.14.0",
    "stylelint": "^17.15.0",
    "stylelint-config-recommended": "^18.0.0",
    "stylelint-config-recommended-scss": "^17.0.1",
    "stylelint-config-recommended-vue": "^2.0.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.0",
    "unplugin-auto-import": "^21.1.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.0",
    "vue-tsc": "^3.3.11"
  },
  "lint-staged": {
    "*.vue": [
      "eslint --fix --max-warnings=0",
      "stylelint --fix --max-warnings=0",
      "prettier --write"
    ],
    "*.{js,jsx,ts,tsx,mjs,cjs}": [
      "eslint --fix --max-warnings=0",
      "prettier --write"
    ],
    "*.{css,scss}": [
      "stylelint --fix --max-warnings=0",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,html}": [
      "prettier --write"
    ]
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged",
    "commit-msg": "pnpm commitlint --edit $1"
  },
  "engines": {
    "node": ">=24.16.0 <25",
    "pnpm": ">=11.20.0 < 12"
  },
  "packageManager": "pnpm@11.20.0",
  "browserslist": [
    "defaults",
    "not dead"
  ]
}
